# Build events.json from content/ file structure
python3 scripts/build-events-from-content.py

# Validate and generate index
npm run validate-events && npm run audit-missing && npm run generate-index

# Auto-bump patch version
node -e "
const fs = require('fs');
const p = JSON.parse(fs.readFileSync('package.json', 'utf8'));
const v = p.version.split('.').map(Number);
v[2]++;
p.version = v.join('.');
fs.writeFileSync('package.json', JSON.stringify(p, null, 2) + '\n');
console.log('Version bumped to ' + p.version);
"

git add data/events.json index.json package.json
