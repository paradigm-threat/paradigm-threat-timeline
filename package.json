{
  "name": "paradigm-threat-timeline",
  "version": "1.2.119",
  "private": true,
  "type": "module",
  "scripts": {
    "build-events": "python3 scripts/build-events-from-content.py",
    "generate-index": "python3 scripts/generate-index.py",
    "validate-events": "python3 scripts/validate-events.py",
    "audit-missing": "python3 scripts/audit-missing.py",
    "build-entries": "python3 scripts/build-entries.py",
    "populate-media": "python3 scripts/populate-media.py",
    "generate-chapter-timeline-svgs": "python3 scripts/generate-chapter-timeline-svgs.py",
    "generate-pdf": "bash scripts/run-with-export-venv.sh scripts/generate-pdf.py",
    "generate-docx": "bash scripts/run-with-export-venv.sh scripts/generate-docx.py",
    "generate-plaintext": "bash scripts/run-with-export-venv.sh scripts/generate-plaintext.py",
    "generate-exports": "npm run generate-pdf && npm run generate-docx",
    "compress-images": "bash scripts/compress-images-for-print.sh all",
    "export": "bash scripts/export.sh",
    "export:images": "bash scripts/export.sh --images",
    "export:russian-remote": "bash scripts/export-russian-remote.sh",
    "dev": "npx serve . -p 3011 --cors",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7"
  }
}
